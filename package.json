{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@zcode/opendesign-plugin",
  "version": "0.1.0",
  "description": "ZCode plugin for OpenDesign — 1,400+ real design systems with grounded design tokens (color, type, spacing, layout, motion) extracted from live sites, served as a native ZCode MCP server + skills + slash commands.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "opendesign-mcp": "./dist/mcp/server.js"
  },
  "main": "./dist/mcp/server.js",
  "types": "./dist/mcp/server.d.ts",
  "exports": {
    "./mcp": {
      "import": "./dist/mcp/server.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://opendesign.cc",
  "repository": {
    "type": "git",
    "url": "https://opendesign.cc/zcode"
  }
}
